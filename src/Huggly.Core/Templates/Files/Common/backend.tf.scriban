# Common/backend.tf.scriban

terraform {
  {{ if environment == "sandbox" || environment == "dev" }}
  # Dev environments use local backend for faster iteration
  backend "local" {
    path = "terraform-{{ environment }}.tfstate"
  }
  {{ else }}
  backend "remote" {
    hostname = "app.terraform.io"
    organization = "{{ terraform_cloud_organization }}"
    
    workspaces {
      name = "{{ terraform_cloud_workspace }}"
    }
  }
  {{ end }}
}