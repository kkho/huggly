# Common/backend.tf.scriban

terraform {
  {{ if state_backend == "remote" }}
  cloud {
    hostname = "app.terraform.io"
    organization = "{{ terraform_cloud_organization }}"
    
    workspaces {
      name = "{{ terraform_cloud_workspace }}"
    }
  }
  {{ else }}
  backend "local" {
    path = "../../.tfstate/{{ system_name | string.downcase }}/{{ environment }}.tfstate"
  }
  {{ end }}
}