locals {
  backend_address_pool_name           = "${azurerm_virtual_network.aks.name}-beap"
  frontend_port_name                  = "${azurerm_virtual_network.aks.name}-feport"
  frontend_ip_configuration_name      = "${azurerm_virtual_network.aks.name}-feip"
  http_setting_name                   = "${azurerm_virtual_network.aks.name}-be-htsts"
  listener_name                       = "${azurerm_virtual_network.aks.name}-httplstn"
  request_routing_rule_name           = "${azurerm_virtual_network.aks.name}-rqrt"
  redirect_configuration_name         = "${azurerm_virtual_network.aks.name}-rdrcfg"

  appgateway_subnet_range = {
    sandbox = "10.132.161.0/24"
    dev     = "10.132.161.0/24"
    kptest  = "10.132.96.0/24"
    test    = "10.132.96.0/24"
    prod    = "10.132.32.0/24"
  }
}

resource "azurerm_public_ip" "app_gtw_public_ip" {
  name = "{{ SystemName }}-{{ Environment }}-pip"

  location                = module.rg.azurerm_resource_group.location
  resource_group_name     = azurerm_virtual_network.aks.resource_group_name
  allocation_method       = "Static"

  sku         = "Standard"
  ip_version  = "IPv4"
}

resource "tfe_variable" "traefik-ip" {
  count = {{ Environment == "sandbox" }} ? 0 : 1

  key          = "traefik-ip"
  value        = azurerm_public_ip.app_gtw_public_ip.ip_address
  category     = "terraform"
  workspace_id = data.tfe_workspace.dns[0].id
  description  = "Set by terraform service. do not manually modify".
}

resource "azurerm_subnet" "appgateway_subnet" {
  name    = "{{ SystemName }}-appgateway-subnet"
  resource_group_name  = azurerm_virtual_network.aks.resource_group_name
  virtual_network_name = azurerm_virtual_network.aks.name
  address_prefixes     = [local.appgateway_subnet_range[{{Environment}}]]
  private_endpoint_network_policies = "Enabled"
}

resource "azurerm_network_security_group" "appgateway_nsg" {
  name               = "{{ SystemName }}-appgateway-nsg-{{ Environment }}"
  location            = module.rg.azurerm_resource_group.location
  resource_group_name = azurerm_virtual_network.aks.resource_group_name


  security_rule {
    name                       = "allow_65200_65535"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "65200-65535"
    source_address_prefix      = "GatewayManager"
    destination_address_prefix = "*"
  }

  security_rule {
    name                       = "deny_185.191.171.0-24"
    priority                   = 200
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "185.191.171.0/24"
    destination_address_prefix = "*"
  }

  security_rule {
    name                       = "deny_CIDR_usa"
    priority                   = 201
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefixes    = ["206.123.132.90", "206.123.132.116", "206.123.132.37", "217.131.99.222"]
    destination_address_prefix = "*"
  }

  security_rule {
    name                       = "allow_80_443"
    priority                   = 1000
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_ranges    = ["80", "443"]
    source_address_prefix      = "Internet"
    destination_address_prefix = "*"
  }
}

resource "azurerm_subnet_network_security_group_association" "appgateway_subnet_nsg" {
  count = {{ Environment == "sandbox" }} ? 0 : 1

  subnet_id                 = azurerm_subnet.appgateway_subnet.id
  network_security_group_id = azurerm_network_security_group.appgateway_nsg.id
}

resource "azurerm_user_assigned_identity" "uai_app_gtw" {
  resource_group_name = module.rg.azurerm_resource_group.name
  location           = module.rg.azurerm_resource_group.location

  name = "uai-{{ SystemName }}-appgtw-{{ Environment }}"
}

resource "azurerm_key_vault_access_policy" "app_gateway_uai" {
  key_vault_id = module.keyvault.azurerm_key_vault.id

  tenant_id = var.tenant_id
  object_id = azurerm_user_assigned_identity.uai_app_gtw.principal_id

  certificate_permissions = [
    "Get",
    "List",
  ]

  secret_permissions = [
    "Get",
    "List",
  ]
}

resource "azurerm_application_gateway" "gateway" {
  name = "aks-appgateway-{{ Environment }}"
  resource_group_name = azurerm_virtual_network.aks.resource_group_name
  location = module.rg.azurerm_resource_group.location

  sku {
    name     = "WAF_v2"
    tier     = "WAF_v2"
  }

  firewall_policy_id = azurerm_web_application_firewall_policy.main.id

  autoscale_configuration {
    min_capacity = {{ if Environment == "prod" }} 2 {{ else }} 1 {{ end }}
    max_capacity = {{ if Environment == "prod" }} 4 {{ else }} 2 {{ end }}
  }

  gateway_ip_configuration {
    name        = "aks-gateway-ip-configuration"
    subnet_id   = azurerm_subnet.appgateway_subnet.id
  }

  identity {
    type          = "UserAssigned"
    identity_ids  = [azurerm_user_assigned_identity.uai_app_gtw.id]
  }

  ssl_certificate {
    name                = "{{ CompanyName }}-io"
    key_vault_secret_id = "${module.keyvault.azurerm_key_vault.vault_uri}secrets/{{ CompanyName }}-io"
  }

  ssl_certificate {
    name                = "{{ CompanyName }}-no"
    key_vault_secret_id = "${module.keyvault.azurerm_key_vault.vault_uri}secrets/{{ CompanyName }}-no"
  }

  dynamic "ssl_certificate" {
    for_each = contains(["dev", "test", "prod"], {{ Environment }}) ? [1] : []

    content {
      name                = "{{ CompanyName }}id-{{ CompanyName }}-no"
      key_vault_secret_id = "${module.keyvault.azurerm_key_vault.vault_uri}secrets/{{ CompanyName }}id-{{ CompanyName }}-no"
    }
  }

  dynamic "ssl_certificate" {
    for_each = contains(["dev", "test", "prod"], {{ Environment }}) ? [1] : []

    content {
      name                = "unsubscribe-{{ CompanyName }}-no"
      key_vault_secret_id = "${module.keyvault.azurerm_key_vault.vault_uri}secrets/unsubscribe-{{ CompanyName }}-no"
    }
  }

  dynamic "ssl_certificate" {
    for_each = contains(["dev", "test", "prod"], {{ Environment }}) ? [1] : []

    content {
      name                = "svar-{{ CompanyName }}-no"
      key_vault_secret_id = "${module.keyvault.azurerm_key_vault.vault_uri}secrets/svar-{{ CompanyName }}-no"
    }
  }

  frontend_port {
    name = local.frontend_port_name
    port = 80
  }

  frontend_ip_configuration {
    name                 = local.frontend_ip_configuration_name
    public_ip_address_id = azurerm_public_ip.app_gtw_public_ip.id
  }

  backend_address_pool {
    name = local.backend_address_pool_name
  }

  backend_http_settings {
    name                  = local.http_setting_name
    cookie_based_affinity = "Disabled"
    path                  = "/path1/"
    port                  = 80
    protocol              = "Http"
    request_timeout       = 60
  }

  http_listener {
    name                           = local.listener_name
    frontend_ip_configuration_name = local.frontend_ip_configuration_name
    frontend_port_name             = local.frontend_port_name
    protocol                       = "Http"
  }

  request_routing_rule {
    name                       = local.request_routing_rule_name
    rule_type                  = "Basic"
    http_listener_name         = local.listener_name
    backend_address_pool_name  = local.backend_address_pool_name
    backend_http_settings_name = local.http_setting_name
    priority                   = 1
  }

  lifecycle {
    ignore_changes = [
      tags, backend_address_pool, backend_http_settings, frontend_port, http_listener, probe, request_routing_rule, redirect_configuration, frontend_ip_configuration, gateway_ip_configuration
    ]
  }
}

resource "azurerm_web_application_firewall_policy" "main" {
  name                = "runtime-wafpolicy-{{ Environment }}-main"
  resource_group_name = azurerm_virtual_network.aks.resource_group_name
  location            = module.rg.azurerm_resource_group.location

  policy_settings {
    enabled                     = true
    mode                        = "Prevention" #{{ Environment }} != "prod" ? "Prevention" : "Detection"
    file_upload_limit_in_mb     = 100
    max_request_body_size_in_kb = 128
    request_body_check          = false
    request_body_enforcement    = false
  }

managed_rules {

    # Enable Rule 100100 Malicious bots detected by threat intelligence
    # Not supported yet: https://github.com/hashicorp/terraform-provider-azurerm/issues/19240
    managed_rule_set {
      type    = "Microsoft_BotManagerRuleSet"
      version = "0.1"
    }

    # Enable most OWASP rules
    managed_rule_set {
      type    = "OWASP"
      version = "3.2"
      rule_group_override {
        rule_group_name = "General"
        rule {
          id      = "200003" # Multipart request body failed strict validation
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-913-SCANNER-DETECTION"
        rule {
          id      = "913101" # Scripting/Generic User-Agents
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-920-PROTOCOL-ENFORCEMENT"
        rule {
          id      = "920311" # Request Has an Empty Accept Header
          enabled = false
        }
        rule {
          id      = "920320" # Empty User-Agent Header
          enabled = false
        }
        rule {
          id      = "920310" # Request Has an Empty Accept Header
          enabled = false
        }
        rule {
          id      = "920470" # Restrict Content-Type header to established patterns
          enabled = false
        }
        rule {
          id      = "920300" # Request Missing an Accept Header
          enabled = false
        }
        rule {
          id      = "920230" # Multiple URL Encoding Detected
          enabled = false
        }
        rule {
          id      = "920440" # URL file extension is restricted by policy
          enabled = false
        }
        rule {
          id      = "920420" # Request content type is not allowed by policy
          enabled = false
        }
        rule {
          id      = "920220" # URL Encoding Abuse Attack Attempt
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-921-PROTOCOL-ATTACK"
        rule {
          id      = "921151" # HTTP Header Injection Attack via payload (CR/LF detected)
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-931-APPLICATION-ATTACK-RFI"
        rule {
          id      = "931130" # Possible Remote File Inclusion (RFI) Attack: Off-Domain Reference/Link
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-932-APPLICATION-ATTACK-RCE"
        rule {
          id      = "932115" # Remote Command Execution: Windows Command Injection
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        rule {
          id      = "941101" # XSS Attack Detected via libinjection
          enabled = false
        }
      }
      rule_group_override {
        rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        rule {
          id      = "942430" # Restricted SQL Character Anomaly Detection (args): # of special characters exceeded (12)
          enabled = false
        }
        rule {
          id      = "942440" # SQL Comment Sequence Detected.
          enabled = false
        }
        rule {
          id      = "942450" # Multiple URL Encoding Detected
          enabled = false
        }
        rule {
          id      = "942100" # SQL Injection Attack Detected via libinjection
          enabled = false
        }
        rule {
          id      = "942110" # SQL Injection Attack: Common Injection Testing Detected
          enabled = false
        }
        rule {
          id      = "942120" # SQL Injection Attack: SQL Operator Detected
          enabled = false
        }
        rule {
          id      = "942130" # SQL Injection Attack: SQL Tautology Detected.
          enabled = false
        }
        rule {
          id      = "942200" # Detects MySQL comment-/space-obfuscated injections and backtick termination
          enabled = false
        }
        rule {
          id      = "942210" # Detects chained SQL injection attempts 1/2
          enabled = false
        }
        rule {
          id      = "942220" # Looking for integer overflow attacks, these are taken from skipfish, except 3.0.00738585072007e-308 is the "magic number" crash
          enabled = false
        }
        rule {
          id      = "942260" # Detects basic SQL authentication bypass attempts 2/3
          enabled = false
        }
        rule {
          id      = "942360" # Detects concatenated basic SQL injection and SQLLFI attempts
          enabled = false
        }
        rule {
          id      = "942330" # Detects classic SQL injection probings 1/3
          enabled = false
        }
        rule {
          id      = "942340" # Detects basic SQL authentication bypass attempts 3/3
          enabled = false
        }
      }
    }

   exclusion {
      match_variable          = "RequestCookieNames"
      selector                = ".AspNetCore."
      selector_match_operator = "StartsWith"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-930-APPLICATION-ATTACK-LFI"
        }
        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieKeys"
      selector                = ".AspNetCore."
      selector_match_operator = "StartsWith"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-930-APPLICATION-ATTACK-LFI"
        }
        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector                = "mp_"
      selector_match_operator = "StartsWith"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-930-APPLICATION-ATTACK-LFI"
        }
        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector                = "session"
      selector_match_operator = "Equals"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector                = "ab.storage.sessionId"
      selector_match_operator = "StartsWith"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector                = "Identity.External"
      selector_match_operator = "StartsWith"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieNames"
