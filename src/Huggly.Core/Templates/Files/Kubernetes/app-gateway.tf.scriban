        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestArgNames"
      selector                = "id"
      selector_match_operator = "Equals"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-931-APPLICATION-ATTACK-RFI"
        }
        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
        }
      }
    }

    exclusion {
      match_variable          = "RequestArgNames"
      selector                = "ReturnUrl"
      selector_match_operator = "Equals"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"
        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
      }
    }

    exclusion {
      match_variable          = "RequestArgNames"
      selector                = "returnUrl"
      selector_match_operator = "Equals"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"
        rule_group {
          rule_group_name = "REQUEST-941-APPLICATION-ATTACK-XSS"
        }
      }
    }

    exclusion {
      match_variable          = "RequestCookieNames"
      selector                = "CookieInformationConsent"
      selector_match_operator = "Equals"

      excluded_rule_set {
        type    = "OWASP"
        version = "3.2"

        rule_group {
          rule_group_name = "REQUEST-942-APPLICATION-ATTACK-SQLI"
          excluded_rules = [
            942370 # Detects classic SQL injection probings 2/2
          ]
        }
      }
    }

  }


  // Add custom rule that allows traffic to api.{{ OrganizationName }}.io that comes from Api Management (check header x-{{ OrganizationName }}-api-management-token)
  custom_rules {
    action    = "Allow"
    name      = "ApiManagementValidHeader"
    priority  = 50
    rule_type = "MatchRule"

    match_conditions {
      match_values = [
        "api.${local.domain}",
      ]
      negation_condition = false
      operator           = "Equal"
      transforms         = []

      match_variables {
        selector      = "Host"
        variable_name = "RequestHeaders"
      }
    }

    match_conditions {
      match_values = [
        random_password.api_management_secret_token.result
      ]
      negation_condition = false
      operator           = "Equal"
      transforms         = []

      match_variables {
        selector      = "x-{{ OrganizationName }}-api-management-token"
        variable_name = "RequestHeaders"
      }
    }
  }

  // Add custom rule with lower priority that block traffic to api.{{ OrganizationName }}.io that does not come from Api Management
  custom_rules {
    action    = "Block"
    name      = "ApiManagementHeaderMissing"
    priority  = 51
    rule_type = "MatchRule"

    match_conditions {
      match_values = [
        "api.${local.domain}",
      ]
      negation_condition = false
      operator           = "Equal"
      transforms         = []

      match_variables {
        selector      = "Host"
        variable_name = "RequestHeaders"
      }
    }
  }

  custom_rules {
    name      = "RuleUSABlock"
    priority  = 70
    rule_type = "MatchRule"

    match_conditions {
      match_variables {
        variable_name = "RemoteAddr"
      }

      operator           = "IPMatch"
      negation_condition = false
      match_values       = ["206.123.132.90", "206.123.132.116", "206.123.132.37", "217.131.99.222"]
    }

    action = "Block"
  }

  # Allow all traffic to IFS passthrough service with $filter, due to many false positives
  custom_rules {
    name      = "DisableIfsFilterSelect"
    priority  = 90
    rule_type = "MatchRule"

    match_conditions {
      match_variables {
        variable_name = "RequestUri"
      }
      transforms = ["Lowercase"]

      operator           = "Contains"
      negation_condition = false
      match_values       = ["passthrough/forward"]
    }

    match_conditions {
      match_variables {
        variable_name = "QueryString"
      }

      operator           = "Contains"
      negation_condition = false
      match_values       = ["$filter", "$select"]
    }

    action = "Allow"
  }

  # Allow all traffic to ifs-extensions subdomain with filter, due to many false positives
  custom_rules {
    name      = "DisableIfsExtensionsFilterSelect"
    priority  = 91
    rule_type = "MatchRule"

    match_conditions {
      match_variables {
        variable_name = "RequestHeaders"
        selector      = "Host"
      }
      transforms = ["Lowercase"]

      operator           = "Contains"
      negation_condition = false
      match_values       = ["ifs-extensions"]
    }

    match_conditions {
      match_variables {
        variable_name = "QueryString"
      }
      transforms = ["Lowercase"]

      operator           = "Contains"
      negation_condition = false
      match_values       = ["filter", "select"]
    }

    action = "Allow"
  }
}

locals {
  domain = {{ Environment == "dev" }} ? "dev-{{ OrganizationName }}.io" : ({{ Environment == "test" }} ? "test-{{ OrganizationName }}.io" : ({{ Environment == "prod" }} ? "{{ OrganizationName }}.io" : "unknown environment"))
}

// Create random password that will be used to check if calls to api.{{ OrganizationName }}.io comes from api management
resource "random_password" "api_management_secret_token" {
  length  = 32
  special = false
}

data "tfe_workspace" "vault_configuration" {
  count = {{ Environment == "sandbox" }} ? 0 : 1

  name         = "vault-configuration-{{ Environment }}"
  organization = "{{ OrganizationName }}"
}

data "tfe_workspace" "{{ OrganizationName }}_topics" {
  # TODO: remove conditional for kptest when edna-topics-kptest has been created
  count = {{ Environment == "sandbox" }} || {{ Environment == "kptest" }} ? 0 : 1

  name         = "edna-topics-{{ Environment }}"
  organization = "{{ OrganizationName }}"
}

//Application gateway logging
resource "azurerm_monitor_diagnostic_setting" "app_gateway" {
  count = {{ Environment == "sandbox" }} ? 0 : 1

  name                       = "appgw-diag-{{ Environment }}"
  target_resource_id         = azurerm_application_gateway.gateway.id
  log_analytics_workspace_id = azurerm_log_analytics_workspace.aksmain.id

  enabled_log {
    category = "ApplicationGatewayFirewallLog"
  }

  enabled_metric {
    category = "AllMetrics"
  }
}

module "storageaccount_waf_logs" {
  source = "./modules/storageaccount"
  count  = {{ Environment == "sandbox" }} ? 0 : 1

  enabled                           = true
  storage_name                      = "runtimewaflogs"
  storage_canonical_name            = "runtimewaflogs"
  environment                       = "{{ Environment }}"
  account_replication_type          = "LRS"
  access_tier                       = "Cool"
  resource_group                    = module.rg.azurerm_resource_group
  system_name                       = "{{ SystemName }}"
  enable_advanced_threat_protection = false
  location_override                 = "{{ Location }}"
  systemaccess_developer_group_id   = "{{ Must find }}" # system systemaccess-aqua-developer
  delete_retention_policy_days      = {{ Environment == "prod" }} ? "180" : "30"
}

//Application gateway logging
resource "azurerm_monitor_diagnostic_setting" "app_gateway_storage_account" {
  count = {{ Environment == "sandbox" }} ? 0 : 1

  name               = "appgw-diag-storage-{{ Environment }}"
  target_resource_id = azurerm_application_gateway.gateway.id
  storage_account_id = module.storageaccount_waf_logs[0].azurerm_storage_account[0].id

  enabled_log {
    category = "ApplicationGatewayAccessLog"
  }

  enabled_log {
    category = "ApplicationGatewayPerformanceLog"
  }

  enabled_log {
    category = "ApplicationGatewayFirewallLog"
  }
}