# infrastructure/main.tf.scriban
provider "azurerm" {
  subscription_id = "{{ SubscriptionId }}"
  tenant_id       = "{{ TenantId }}"

  features {}
}

provider "azurerm" {
  alias = "{{ AzureAlias}}"
  subscription_id = "{{ SubscriptionId }}"
  tenant_id       = "{{ TenantId }}"

  features {}
}

provider "azuread" {
  tenant_id = "{{ TenantId }}"
}

provider "azuredevops" {
}

provider "kubernetes" {
  host = module.kubernetes.azurerm_aks.kube_admin_config[0].host
  client_certiticate = base64decode(module.kubernetes.azurerm_aks.kube_admin_config[0].client_certificate),
  client_key = base64decode(module.kubernetes.azurerm_aks.kube_admin_config[0].client_key),
  cluster_ca_certificate = base64decode(module.kubernetes.azurerm_aks.kube_admin_config[0].cluster_ca_certificate),
}

provider "helm" {
  kubernetes = {
    host = module.kubernetes.azurerm_aks.kube_admin_config[0].host
    client_certiticate = base64decode(module.kubernetes.azurerm_aks.kube_admin_config[0].client_certificate),
    client_key = base64decode(module.kubernetes.azurerm_aks.kube_admin_config[0].client_key),
    cluster_ca_certificate = base64decode(module.kubernetes.azurerm_aks.kube_admin_config[0].cluster_ca_certificate),
  }
}

provider tfe {}

locals {
  location = "{{ Resources.Location }}"
  admin_group_object_id = "{{ AdminGroupObjectId }}"
}

resource "azurerm_resource_group" "{{ Resources.ResourceGroupName }}_rg" {
  name     = "rg-{{ Resources.ResourceGroupName }}-{{ Environment }}"
  location = local.location
}

module "rg_acr" {
  source = "./modules/resourcegroup"

  system_name = "CONTAINERREGISTRY"
  environment = {{ Environment }}
  location    = local.location
  enabled     = {{ if Environment == "prod" }}true{{ else }}false{{ end }}
}

module "keyvault" {
  source = "./modules/keyvault"

  keyvault_name = {{ if Environment == "sandbox" || Environment == "kptest"}} "aks-core" {{ else }} "aks-coreservice"{{ end }}
  environment = {{ Environment }}
  resource_group = module.rg.azurerm_resource_group
  admin_group_id = local.admin_group_id
}

locals {
  aks_vnet_name = {
    sandbox = "{{ CompanyName }}-d-vnet-sandbox"
    dev = "{{ CompanyName }}-d-vnet-dev"
    kptest = "{{ CompanyName }}-t-vnet-kptest"
    test = "{{ CompanyName }}-t-vnet-test"
    prod = "{{ CompanyName }}-p-vnet-prod"
  }

  aks_vnet_resource_group_name = {
    sandbox = "{{ CompanyName }}-d-rg-vnet-sandbox"
    dev = "{{ CompanyName }}-d-rg-vnet-dev"
    kptest = "{{ CompanyName }}-t-rg-vnet-kptest"
    test = "{{ CompanyName }}-t-rg-vnet-test"
    prod = "{{ CompanyName }}-p-rg-vnet-prod"
  }

  aks_vnet_address_space = {
    sandbox = ["10.0.0.0/16", "10.10.0.0/16", "10.132.128.0/18"]
    dev     = ["10.132.128.0/18"]
    kptest  = ["10.132.64.0/18", "10.247.0.0/16"]
    test    = ["10.132.64.0/18", "10.247.0.0/16"]
    prod    = ["10.132.0.0/18", "10.248.0.0/16"]
  }

  aks_subnet_name = {
    sandbox = "{{ CompanyName }}-d-snet-sandbox-sub01"
    dev = "{{ CompanyName }}-d-snet-dev-sub01"
    kptest = "{{ CompanyName }}-t-snet-kptest-sub01"
    test = "{{ CompanyName }}-t-snet-test-sub01"
    prod = "{{ CompanyName }}-p-snet-prod-sub01"
  }

  aks_subnet_address_prefixes = {
    sandbox = ["10.132.128.0/19"]
    dev     = ["10.132.128.0/19"]
    kptest  = ["10.132.64.0/19"]
    test    = ["10.132.64.0/19"]
    prod    = ["10.132.0.0/19"]
  }
}

resource "azurerm_resource_group" "aks-vnet" {
  name    = local.aks_vnet_resource_group_name["{{ Environment }}"]
  location = local.location
}

resource "azurerm_virtual_network" "aks" {
  name                = local.aks_vnet_name["{{ Environment }}"]
  resource_group_name = local.aks_vnet_resource_group_name["{{ Environment }}"]
  location            = local.location
  address_space       = local.aks_vnet_address_space["{{ Environment }}"]
}

ddos_protection_plan {
  enable = true
  // TODO need subscription
  id = ""
}

resource "azurerm_subnet" "aks" {
  name = local.aks_subnet_name["{{ Environment }}"]
  virtual_network_name = azurerm_virtual_network.aks.name
  resource_group_name = azurerm_virtual_network.aks.resource_group_name
  address_prefixes = local.aks_subnet_address_prefixes["{{ Environment }}"]
  private_endpoint_network_policies = {{ if Environment == "sandbox" }}"Disabled"{{ else }}"Enabled"{{ end }}
}

data "azurerm_subnet" "wag-aks" {
  count = {{ if Environment == "dev" }} 1 {{ else }} 0 {{ end }}

  name ="{{ CompanyName }}-d-snet-dev-sub01"
  virtual_network_name = azurerm_virtual_network.aks.name
  resource_group_name = azurerm_virtual_network.aks.resource_group_name
}

# Azure Container Registry
module "containerregistry" {
  source = "./modules/containerregistry"

  name                      = "Containerregistry{{ CompanyName }}"
  enabled                   = {{ if Environment == "prod" }}true{{ else }}false{{ end }}
  environment               = {{ Environment }}
  resource_group            = module.rg_acr.azurerm_resource_group
  system_name               = {{ SystemName }}
  sku                       = "Premium"
  admin_enabled             = {{ AdminEnabled }}
  georeplication_locations  = {{ GeoReplicationLocations }}
  key_vault_id              = module.keyvault.azurerm_key_vault.id
}

#Log Analytics Workspace
resource "azurerm_log_analytics_workspace" "aksmain" {
  name                       = "{{ SystemName }}-log-workspace-{{ Environment }}"
  location                   = local.location
  resource_group_name        = module.rg.azurerm_resource_group.name
  sku                        = "PerGB2018"
  retention_in_days          = 30
  internet_ingestion_enabled = true
  internet_query_enabled     = true
}

resource "azurerm_log_analytics_solution" "aksmain" {
  solution_name         = "ContainerInsights"
  location              = module.rg.azurerm_resource_group.location
  resource_group_name   = module.rg.azurerm_resource_group.name
  workspace_resource_id = azurerm_log_analytics_workspace.aksmain.id
  workspace_name        = azurerm_log_analytics_workspace.aksmain.name

  plan {
    publisher = "Microsoft"
    product   = "OMSGallery/ContainerInsights"
  }
}

# Only used for kptest
resource "tls_private_key" "aks-ssh-key" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

locals {
  kubernetes_version = {
    sandbox = "1.31.10"
    dev     = "1.31.10"
    kptest  = "1.31.10"
    test    = "1.30.9"
    prod    = "1.30.9"
  }

  ssh_public_key = {
    sandbox = "ssh-rsa  aks-sandbox-key-20260428"
    dev     = "ssh-rsa  aks-dev-key-20260428" 
    kptest  = tls_private_key.aks-ssh-key.public_key_openssh
    test    = "ssh-rsa  aks-test-key-20260428"
    prod    = "ssh-rsa  aks-prod-key-20260428"
  }

  system_node_pool {
    sandbox = {
      vm_size             = "Standard_DS2_v2"
      zones               = [1]
      node_count          = 1
      only_ciritcal_addons_enabled = false 
    }

    dev = {
      vm_size             = "Standard_D4ds_v5"
      zones               = [1, 2, 3]
      node_count          = 2
    }

    kptest = {
      vm_size             = "Standard_D8ds_v5"
      zones               = [1, 2, 3]
      node_count          = 2
    }

    test = {
      vm_size             = "Standard_D8ds_v5"
      zones               = [1, 2, 3]
      node_count          = 2
    }

    prod = {
      vm_size             = "Standard_D8ds_v5"
      zones               = [1, 2, 3]
      node_count          = 2
    }
  }

  user_node_pools = {
    dev = {
      vm_size   = "Standard_D8ds_v5"
      zones     = [1, 2, 3]
      min_count = 3
      max_count = 8
    }

    kptest = {
      vm_size   = "Standard_D16ds_v5"
      zones     = [1, 2, 3]
      min_count = 6
      max_count = 10
    }

    test = {
      vm_size   = "Standard_D16ds_v5"
      zones     = [1, 2, 3]
      min_count = 6
      max_count = 10
    }

    prod = {
      vm_size   = "Standard_D16ds_v5"
      zones     = [1, 2, 3]
      min_count = 8
      max_count = 12
    }
  }

  prometheus_node_pools = {
    dev = {
      vm_size     = "Standard_D4ds_v5"
      min_count   = 1
      max_count   = 3
      node_taints = ["type=high-iops:NoSchedule"]
      node_labels = { type = "high-iops" }
    }

    kptest = {
      vm_size     = "Standard_D4ds_v5"
      min_count   = 1
      max_count   = 6
      node_taints = ["type=high-iops:NoSchedule"]
      node_labels = { type = "high-iops" }
    }

    test = {
      vm_size     = "Standard_D4ds_v5"
      min_count   = 1
      max_count   = 6
      node_taints = ["type=high-iops:NoSchedule"]
      node_labels = { type = "high-iops" }
    }

    prod = {
      vm_size     = "Standard_D4ds_v5"
      min_count   = 1
      max_count   = 6
      node_taints = ["type=high-iops:NoSchedule"]
      node_labels = { type = "high-iops" }
    }
  }
}

#K8s
module "kubernetes" {
  source      = "./modules/aks"
  depends_on  = [module.keyvault]

  name                  = "akscluster"
  system_name           = {{ SystemName }}
  resource_group        = module.rg.azurerm_resource_group
  sku_tier              =  {{ if Environment == "sandbox" }}"Free"{{ else }}"Standard"{{ end }}

  ssh_public_key        = local.ssh_public_key[{{ Environment }}]
  dns_service_ip        = "10.0.0.10"
  docker_bridge_cidr    = "172.17.0.1/16"
  service_cidr          = "10.0.0.0/16"
  oms_agent_enabled     = false

  vnet_subnet_id                = azurerm_subnet.aks.id
  key_vault_id                  = module.keyvault.azurerm_key_vault.id
  log_analytics_workspace_id    = azurerm_log_analytics_workspace.aksmain.id
  log_analytics_workspace_name  = azurerm_log_analytics_workspace.aksmain.name

  system_node_pool = local.system_node_pool[{{ Environment }}]
  user_node_pools = (
    var.environment == "sandbox" ?
    null :
    {
      user     = local.user_node_pools[{{ Environment }}]
      highiops = local.prometheus_node_pools[{{ Environment }}] # TODO: rename from highiops to prometheus
    }
  )
}

resource "kubernetes_storage_class" "azure" {
  metadata {
    name = "common-azure-file"
  }

  storage_provisioner = "kubernetes.io/azure-file"
  reclaim_policy      = "Delete"

  parameters = {
    skuName  = "{{ StorageSku }}"
    location = "{{ Location }}"
  }

  mount_options = [
    "dir_mode=0777",
    "file_mode=0777",
    "uid=1000",
    "gid=11433",
    "mfsymlinks",
    "nobrl",
    "cache=none"
  ]
}

resource "kubernetes_namespace" "oidc" {
  metadata {
    name = "oidc"
  }
}

resource "kubernetes_config_map" "oidc_oidc" {
  metadata {
    name      = "oidc"
    namespace = kubernetes_namespace.oidc.metadata.0.name
    annotations = {
      "info" = "The oidc_issuer_url is used by workload identity to authenticate service accounts to Azure. It is used when creating federated credentials in the module terraform-kubernetes-serviceaccount. If this URL ever changes, _ALL_ of the federated credentials must be recreated!"
    }
  }

  data = {
    oidc_issuer_url = module.kubernetes.azurerm_aks.oidc_issuer_url
  }
}

#Cluster roles

#Cluster role bindings
resource "azurerm_role_assignment" "aks" {
  scope                = module.kubernetes.azurerm_aks.id
  role_definition_name = "Monitoring Metrics Publisher"
  principal_id         = module.kubernetes.azurerm_aks.identity[0].principal_id
}

resource "azurerm_role_assignment" "aks_subnet" {
  scope                = azurerm_subnet.aks.id
  role_definition_name = "Network Contributor"
  principal_id         = module.kubernetes.azurerm_aks.identity[0].principal_id
}

resource "azurerm_role_assignment" "acr" {
  count = {{ if ACRResourceId != null }}1{{ else if Environment == "prod" }}1{{ else }}0{{ end }}

  skip_service_principal_aad_check = true
  scope                            = {{ if ACRResourceId != null }}{{ ACRResourceId }}{{ else }}{{ module.containerregistry.azurerm_container_registry.id }}{{ end }}
  role_definition_name             = "AcrPull"
  principal_id                     = module.kubernetes.azurerm_aks.kubelet_identity[0].object_id
}

resource "kubernetes_cluster_role_binding" "aks" {
  metadata {
    name = "cluster-admins"
  }

  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "ClusterRole"
    name      = "cluster-admin"
  }

  subject {
    api_group = "rbac.authorization.k8s.io"
    kind      = "Group"
    name      = local.admin_group_id
  }
}

resource "kubernetes_cluster_role" "developer" {
  metadata {
    name = "developer"
  }

  rule {
    api_groups = ["*"]
    resources  = ["*"]
    verbs      = ["*"]
  }
}

resource "kubernetes_cluster_role" "list_namespaces" {
  metadata {
    name = "list-namespaces"
  }

  rule {
    api_groups = [""]
    resources  = ["namespaces"]
    verbs      = ["get", "list"]
  }
}

resource "kubernetes_cluster_role" "pod_reader" {
  metadata {
    name = "pod-reader"
  }

  rule {
    api_groups = [""]
    resources  = ["pods"]
    verbs      = ["get"]
  }
}

resource "kubernetes_cluster_role" "kubernetes_dashboard" {
  metadata {
    name = "kubernetes-dashboard-readall"
  }

  rule {
    api_groups = ["*"]
    resources = [
      "services",
      "cronjobs",
      "daemonsets",
      "deployments",
      "endpoints",
      "jobs",
      "pods",
      "pods/log",
      "replicasets",
      "replicationcontrollers",
      "ingresses",
      "configmaps",
      "persistentvolumeclaims",
      "events",
      "statefulsets",
      "namespaces",
      "roles",
      "persistentvolumes",
      "clusterroles",
      "nodes",
      "storageclasses"
    ]
    verbs = ["get", "list", "watch"]
  }
}

resource "kubernetes_cluster_role_binding" "kubernetes_dashboard" {
  metadata {
    name = "kubernetes-dashboard-readall"
  }

  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "ClusterRole"
    name      = "kubernetes-dashboard-readall"
  }

  subject {
    kind      = "ServiceAccount"
    name      = "kubernetes-dashboard"
    namespace = "kube-system"
  }
}

resource "kubernetes_role" "user_role_dashboard" {
  metadata {
    name      = "user-role-dashboard"
    namespace = "kube-system"
  }

  rule {
    api_groups = [""]
    resources  = ["services"]
    verbs      = ["get", "list", "watch"]
  }

  rule {
    api_groups = [""]
    resources  = ["services/proxy"]
    verbs      = ["get", "list", "watch", "create"]
  }
}

resource "azurerm_public_ip" "static_public_ip" {
  name                = "k8s-integration"
  location            = module.rg.azurerm_resource_group.location
  resource_group_name = module.rg.azurerm_resource_group.name
  allocation_method   = "Dynamic"
  sku                 = "Basic"
}

# Give sp-terraform-system-bootstrap User Admin on the resource groups
resource "azurerm_role_assignment" "system_bootstrap_user_admin" {
  scope                = module.rg.azurerm_resource_group.id
  role_definition_name = "User Access Administrator"
  principal_id         = "" # Object ID of sp-terraform-system-bootstrap TODO
}

# Give sp-terraform-system-bootstrap User Access Admin on the resource groups
resource "azurerm_role_assignment" "system_bootstrap_user_admin_acr_resource_id" {
  count = {{ if Environment == "prod" }} 1 {{ else }} 0 {{ end }}

  scope                = module.containerregistry.azurerm_container_registry.id
  role_definition_name = "User Access Administrator"
  principal_id         = "" # Object ID of sp-terraform-system-bootstrap TODO
}

######## kured ############
resource "kubernetes_cluster_role" "kured" {
  metadata {
    name = "kured"
  }

  rule {
    api_groups = [""]
    resources  = ["nodes"]
    verbs      = ["get", "patch"]
  }

  rule {
    api_groups = [""]
    resources  = ["pods"]
    verbs      = ["list", "delete", "get"]
  }

  rule {
    api_groups = ["apps"]
    resources  = ["daemonsets"]
    verbs      = ["get"]
  }

  rule {
    api_groups = [""]
    resources  = ["pods/eviction"]
    verbs      = ["create"]
  }
}

resource "kubernetes_cluster_role_binding" "kured" {
  metadata {
    name = "kured"
  }

  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "ClusterRole"
    name      = "kured"
  }

  subject {
    kind      = "ServiceAccount"
    name      = "kured"
    namespace = "kube-system"
  }
}

resource "kubernetes_role" "kured" {
  metadata {
    name      = "kured"
    namespace = "kube-system"
  }

  # Allow kured to lock/unlock itself
  rule {
    api_groups     = ["apps"]
    resources      = ["daemonsets"]
    resource_names = ["kured"]
    verbs          = ["update"]
  }
}

resource "kubernetes_role_binding" "kured" {
  metadata {
    name      = "kured"
    namespace = "kube-system"
  }

  role_ref {
    api_group = "rbac.authorization.k8s.io"
    kind      = "Role"
    name      = "kured"
  }

  subject {
    kind      = "ServiceAccount"
    name      = "kured"
    namespace = "kube-system"
  }
}

resource "kubernetes_service_account" "kured" {
  metadata {
    name      = "kured"
    namespace = "kube-system"
  }

  automount_service_account_token = false
}

resource "azurerm_resource_group_policy_assignment" "kubernetes_pod_security_restricted" {
  name                 = "kubernetes-pod-security-restricted"
  resource_group_id    = module.rg.azurerm_resource_group.id
  policy_definition_id = {{if Environment == "prod"}} 
  "/subscriptions/<Need subscription id>/providers/Microsoft.Authorization/policySetDefinitions/fd574fbc826a49e8bd87062c" {{else}} 
  "/subscriptions/<Need another subscription id>/providers/microsoft.authorization/policysetdefinitions/3cbe00828a5d4568b73d1ff1" {{end}} # Organization Kubernetes cluster pod security restricted standards for Linux-based workloads
  display_name         = "{{Organization }} Kubernetes cluster pod security restricted - {{ Environment }}"
  location             = module.rg.azurerm_resource_group.location

  identity {
    type = "SystemAssigned"
  }

  parameters = <<-EOF
    {
        "effect": {
            "value": "deny"
        },
        "excludedNamespaces": {
            "value": ["kube-system", "gatekeeper-system", "monitoring", "linkerd", "linkerd-viz", "kapasitetskart", "cert-manager", "policy-controller", "dataprotection-microsoft", "external-secrets"]
        },
        "excludedImages": {
            "value": ["cr.l5d.io/linkerd/proxy-init:*"]
        }
    }
  EOF

}

#### START Managed Identity for Vault in Hub-Network ###
resource "azurerm_user_assigned_identity" "app_gateway_key_vault" {
  count = {{ if Environment == "prod" }}1 {{ else }} 0  {{ end }}// Application Gateway is for all Environemnts

  name                = "appgateway-{{ Organization }}-h-kv-infra01"
  resource_group_name = module.rg.azurerm_resource_group.name
  location            = module.rg.azurerm_resource_group.location
}
#### END Managed Identity for Vault in Hub-Network