# Modules/integration/api_managements.tf.scriban

{{- for apim in api_managements }}
resource "azurerm_api_management" "{{ apim.name | string.downcase }}" {
  name                = "{{ apim.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"
  publisher_name      = "{{ apim.publisher_name }}"
  publisher_email     = "{{ apim.publisher_email }}"
  sku_name            = "{{ apim.sku_name }}"

  {{- if apim.identity }}
  identity {
    type = "{{ apim.identity.type }}"
    {{- if apim.identity.identity_ids }}
    identity_ids = {{ apim.identity.identity_ids | array.join ", " | string.prepend "[" | string.append "]" }}
    {{- end }}
  }
  {{- end }}
}
{{ end }}
