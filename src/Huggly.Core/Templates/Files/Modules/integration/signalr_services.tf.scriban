# Modules/integration/signalr_services.tf.scriban

{{- for signalr in signalr_services }}
resource "azurerm_signalr_service" "{{ signalr.name | string.downcase }}" {
  name                = "{{ signalr.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"

  sku {
    name     = "{{ signalr.sku.name }}"
    capacity = {{ signalr.sku.capacity }}
  }

  service_mode = "{{ signalr.service_mode }}"
}
{{ end }}
