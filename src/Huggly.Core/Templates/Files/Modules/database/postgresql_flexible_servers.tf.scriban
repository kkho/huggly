# Modules/database/postgresql_flexible_servers.tf.scriban

{{- for server in postgresql_flexible_servers }}
resource "azurerm_postgresql_flexible_server" "{{ server.name | string.downcase }}" {
  name                          = "{{ server.name }}-{{ environment }}"
  resource_group_name           = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location                      = "{{ location }}"
  version                       = "{{ server.version }}"
  administrator_login           = "{{ server.administrator_login }}"
  administrator_password        = var.{{ server.name | string.downcase }}_admin_password
  sku_name                      = "{{ server.sku_name }}"
  storage_mb                    = {{ server.storage_mb }}
  public_network_access_enabled = {{ server.public_network_access_enabled | string.downcase }}
  zone                          = "{{ server.zone }}"
}

{{- for db in server.databases }}
resource "azurerm_postgresql_flexible_server_database" "{{ server.name | string.downcase }}_{{ db.name | string.downcase }}" {
  name      = "{{ db.name }}"
  server_id = azurerm_postgresql_flexible_server.{{ server.name | string.downcase }}.id
  collation = "{{ db.collation }}"
  charset   = "{{ db.charset }}"
}
{{- end }}
{{ end }}
