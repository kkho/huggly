# Modules/database/mysql_flexible_servers.tf.scriban

{{- for server in mysql_flexible_servers }}
resource "azurerm_mysql_flexible_server" "{{ server.name | string.downcase }}" {
  name                   = "{{ server.name }}-{{ environment }}"
  resource_group_name    = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location               = "{{ location }}"
  version                = "{{ server.version }}"
  administrator_login    = "{{ server.administrator_login }}"
  administrator_password = var.{{ server.name | string.downcase }}_admin_password
  sku_name               = "{{ server.sku_name }}"
  zone                   = "{{ server.zone }}"
}

{{- for db in server.databases }}
resource "azurerm_mysql_flexible_database" "{{ server.name | string.downcase }}_{{ db.name | string.downcase }}" {
  name                = "{{ db.name }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  server_name         = azurerm_mysql_flexible_server.{{ server.name | string.downcase }}.name
  charset             = "{{ db.charset }}"
  collation           = "{{ db.collation }}"
}
{{- end }}
{{ end }}
