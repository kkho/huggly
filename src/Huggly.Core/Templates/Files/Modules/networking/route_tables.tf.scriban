# Modules/networking/route_tables.tf.scriban

{{- for rt in route_tables }}
resource "azurerm_route_table" "{{ rt.name | string.downcase }}" {
  name                = "{{ rt.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"
  bgp_route_propagation_enabled = {{ rt.bgp_route_propagation_enabled | string.downcase }}

  {{- for route in rt.routes }}
  route {
    name                   = "{{ route.name }}"
    address_prefix         = "{{ route.address_prefix }}"
    next_hop_type          = "{{ route.next_hop_type }}"
    {{- if route.next_hop_in_ip_address }}
    next_hop_in_ip_address = "{{ route.next_hop_in_ip_address }}"
    {{- end }}
  }
  {{- end }}
}
{{ end }}
