# Modules/networking/front_doors.tf.scriban

{{- for fd in front_doors }}
resource "azurerm_cdn_frontdoor_profile" "{{ fd.name | string.downcase }}" {
  name                = "{{ fd.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  sku_name            = "{{ fd.sku_name }}"
}

{{- if fd.endpoints }}
{{- for endpoint in fd.endpoints }}
resource "azurerm_cdn_frontdoor_endpoint" "{{ fd.name | string.downcase }}_{{ endpoint.name | string.downcase }}" {
  name                     = "{{ endpoint.name }}"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.{{ fd.name | string.downcase }}.id
  enabled                  = {{ endpoint.enabled | string.downcase }}
}
{{- end }}
{{- end }}

{{- if fd.origin_groups }}
{{- for group in fd.origin_groups }}
resource "azurerm_cdn_frontdoor_origin_group" "{{ fd.name | string.downcase }}_{{ group.name | string.downcase }}" {
  name                     = "{{ group.name }}"
  cdn_frontdoor_profile_id = azurerm_cdn_frontdoor_profile.{{ fd.name | string.downcase }}.id
  session_affinity_enabled = {{ group.session_affinity_enabled | string.downcase }}

  load_balancing {
    sample_size                 = {{ group.load_balancing.sample_size }}
    successful_samples_required = {{ group.load_balancing.successful_samples_required }}
  }
}
{{- end }}
{{- end }}
{{ end }}
