# Modules/networking/dns_zones.tf.scriban

{{- for zone in dns_zones }}
resource "azurerm_dns_zone" "{{ zone.name | string.downcase | string.replace "." "_" }}" {
  name                = "{{ zone.name }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
}

{{- if zone.a_records }}
{{- for record in zone.a_records }}
resource "azurerm_dns_a_record" "{{ zone.name | string.downcase | string.replace "." "_" }}_{{ record.name | string.downcase }}" {
  name                = "{{ record.name }}"
  zone_name           = azurerm_dns_zone.{{ zone.name | string.downcase | string.replace "." "_" }}.name
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  ttl                 = {{ record.ttl }}
  records             = {{ record.records | array.join ", " | string.prepend "[" | string.append "]" }}
}
{{- end }}
{{- end }}

{{- if zone.cname_records }}
{{- for record in zone.cname_records }}
resource "azurerm_dns_cname_record" "{{ zone.name | string.downcase | string.replace "." "_" }}_{{ record.name | string.downcase }}" {
  name                = "{{ record.name }}"
  zone_name           = azurerm_dns_zone.{{ zone.name | string.downcase | string.replace "." "_" }}.name
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  ttl                 = {{ record.ttl }}
  record              = "{{ record.record }}"
}
{{- end }}
{{- end }}
{{ end }}
