# Modules/networking/bastion_hosts.tf.scriban

{{- for bastion in bastion_hosts }}
resource "azurerm_bastion_host" "{{ bastion.name | string.downcase }}" {
  name                = "{{ bastion.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"
  sku                 = "{{ bastion.sku }}"

  ip_configuration {
    name                 = "{{ bastion.name | string.downcase }}-ipconfig"
    subnet_id            = "{{ bastion.subnet_id }}"
    public_ip_address_id = azurerm_public_ip.{{ bastion.public_ip | string.downcase }}.id
  }
}
{{ end }}
