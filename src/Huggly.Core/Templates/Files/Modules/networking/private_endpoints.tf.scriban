# Modules/networking/private_endpoints.tf.scriban

{{- for pe in private_endpoints }}
resource "azurerm_private_endpoint" "{{ pe.name | string.downcase }}" {
  name                = "{{ pe.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"
  subnet_id           = "{{ pe.subnet_id }}"

  private_service_connection {
    name                           = "{{ pe.name | string.downcase }}-psc"
    private_connection_resource_id = "{{ pe.private_connection_resource_id }}"
    is_manual_connection           = {{ pe.is_manual_connection | string.downcase }}
    subresource_names              = {{ pe.subresource_names | array.join ", " | string.prepend "[" | string.append "]" }}
  }

  {{- if pe.private_dns_zone_group }}
  private_dns_zone_group {
    name                 = "{{ pe.private_dns_zone_group.name }}"
    private_dns_zone_ids = {{ pe.private_dns_zone_group.private_dns_zone_ids | array.join ", " | string.prepend "[" | string.append "]" }}
  }
  {{- end }}
}
{{ end }}
