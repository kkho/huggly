# Modules/networking/virtual_networks.tf.scriban

{{- for vnet in virtual_networks }}
resource "azurerm_virtual_network" "{{ vnet.name | string.downcase }}" {
  name                = "{{ vnet.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"
  address_space       = {{ vnet.address_space | array.join ", " | string.prepend "[" | string.append "]" }}
  {{- if vnet.dns_servers }}
  dns_servers         = {{ vnet.dns_servers | array.join ", " | string.prepend "[" | string.append "]" }}
  {{- end }}
}

{{- if vnet.subnets }}
{{- for subnet in vnet.subnets }}
resource "azurerm_subnet" "{{ vnet.name | string.downcase }}_{{ subnet.name | string.downcase }}" {
  name                 = "{{ subnet.name }}"
  resource_group_name  = azurerm_resource_group.{{ system_name | string.downcase }}.name
  virtual_network_name = azurerm_virtual_network.{{ vnet.name | string.downcase }}.name
  address_prefixes     = {{ subnet.address_prefixes | array.join ", " | string.prepend "[" | string.append "]" }}
  {{- if subnet.service_endpoints }}
  service_endpoints    = {{ subnet.service_endpoints | array.join ", " | string.prepend "[" | string.append "]" }}
  {{- end }}
}
{{- end }}
{{- end }}
{{ end }}
