# Modules/compute/windows_virtual_machines.tf.scriban

{{- for vm in windows_virtual_machines }}
resource "azurerm_windows_virtual_machine" "{{ vm.name | string.downcase }}" {
  name                  = "{{ vm.name }}-{{ environment }}"
  resource_group_name   = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location              = "{{ location }}"
  size                  = "{{ vm.size }}"
  admin_username        = "{{ vm.admin_username }}"
  admin_password        = var.{{ vm.name | string.downcase }}_admin_password
  network_interface_ids = [azurerm_network_interface.{{ vm.network_interface | string.downcase }}.id]

  os_disk {
    caching              = "{{ vm.os_disk.caching }}"
    storage_account_type = "{{ vm.os_disk.storage_account_type }}"
  }

  source_image_reference {
    publisher = "{{ vm.source_image.publisher }}"
    offer     = "{{ vm.source_image.offer }}"
    sku       = "{{ vm.source_image.sku }}"
    version   = "{{ vm.source_image.version }}"
  }
}
{{ end }}
