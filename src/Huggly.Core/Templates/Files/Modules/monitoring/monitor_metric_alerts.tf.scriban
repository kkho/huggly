# Modules/monitoring/monitor_metric_alerts.tf.scriban

{{- for alert in monitor_metric_alerts }}
resource "azurerm_monitor_metric_alert" "{{ alert.name | string.downcase }}" {
  name                = "{{ alert.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  scopes              = {{ alert.scopes | array.join ", " | string.prepend "[" | string.append "]" }}
  description         = "{{ alert.description }}"
  severity            = {{ alert.severity }}
  frequency           = "{{ alert.frequency }}"
  window_size         = "{{ alert.window_size }}"

  criteria {
    metric_namespace = "{{ alert.criteria.metric_namespace }}"
    metric_name      = "{{ alert.criteria.metric_name }}"
    aggregation      = "{{ alert.criteria.aggregation }}"
    operator         = "{{ alert.criteria.operator }}"
    threshold        = {{ alert.criteria.threshold }}
  }

  action {
    action_group_id = azurerm_monitor_action_group.{{ alert.action_group | string.downcase }}.id
  }
}
{{ end }}
