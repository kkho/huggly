# Modules/monitoring/application_insights.tf.scriban

{{- for insight in application_insights }}
resource "azurerm_application_insights" "{{ insight.name | string.downcase }}" {
  name                = "{{ insight.name }}-{{ environment }}"
  resource_group_name = azurerm_resource_group.{{ system_name | string.downcase }}.name
  location            = "{{ location }}"
  application_type    = "{{ insight.application_type }}"
  {{- if insight.workspace }}
  workspace_id        = azurerm_log_analytics_workspace.{{ insight.workspace | string.downcase }}.id
  {{- end }}
  {{- if insight.retention_in_days }}
  retention_in_days   = {{ insight.retention_in_days }}
  {{- end }}
  sampling_percentage = {{ insight.sampling_percentage }}
}
{{ end }}
